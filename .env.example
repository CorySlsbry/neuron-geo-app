# Copy to .env.local (gitignored). NEVER commit real values.
NODE_ENV=development
APP_URL=http://localhost:3000

# App role — NON-superuser, no BYPASSRLS. Used by the running app so it can
# never bypass RLS.
DATABASE_URL=postgres://app_user:app_pw@localhost:5433/neurongeo

# Migration role — superuser/owner. Used by `pnpm migrate` ONLY.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/neurongeo

# Auth: "dev" = local email-only login (refuses to run in production);
# "identity-platform" = GCP Identity Platform ID-token verify + TOTP.
AUTH_MODE=dev
# GCP_PROJECT_ID=
# IDENTITY_PLATFORM_API_KEY=
# SESSION_SECRET=                 # >=32 chars; required in prod

# Public origin for Stripe return URLs (checkout, billing portal). A localhost
# value in production sends a paying customer to a page that does not exist —
# env.ts refuses that combination.
APP_ORIGIN=http://localhost:3010

# --- billing (NEURON Stripe account — never another account's keys) --------
# Prices are resolved at runtime by lookup_key: geo_start_89 / geo_growth_199.
# Empty = billing fails closed with a plain 503; the rest of the app works.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=          # may hold several, comma-separated (rotation)

# --- channel connections (OAuth) -------------------------------------------
# Fernet key sealing every stored OAuth token. 32 bytes, base64url. Absent =
# NO network can be connected and every Connect button says so before it is
# clicked. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CHANNEL_TOKEN_KEY=

# The address printed on the PUBLIC /data-deletion page (the URL Meta's App
# Review asks for). Must be a mailbox somebody actually reads.
# SUPPORT_EMAIL=privacy@neuron-hq.com

# One client per network. BOTH halves are required or the network renders
# disabled. Redirect URI to register with each provider:
#   ${APP_URL}/api/channels/callback/<network>
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=
# INSTAGRAM_OAUTH_CLIENT_ID=
# INSTAGRAM_OAUTH_CLIENT_SECRET=
# TIKTOK_OAUTH_CLIENT_KEY=          # TikTok calls its client id a client key
# TIKTOK_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
